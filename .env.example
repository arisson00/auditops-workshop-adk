# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=<SEU_PROJECT_ID>
GOOGLE_CLOUD_PROJECT_NUMBER=<NUMERO_DO_PROJETO>
GOOGLE_CLOUD_LOCATION=us-central1
# Endpoint dos modelos Gemini 3.x (só existem em `global`); GOOGLE_CLOUD_LOCATION fica como região da infra
GEMINI_LOCATION=global
# true = falha no pipeline ADK real retorna erro 502 em vez de cair na simulação
AUDITOPS_STRICT_LIVE=false
# Proteção do serviço público: auditorias simultâneas por instância, pedidos por IP/hora e tamanho máximo do envio
AUDITOPS_MAX_CONCURRENT_AUDITS=3
AUDITOPS_AUDITS_PER_HOUR=20
AUDITOPS_CHATS_PER_HOUR=60
AUDITOPS_MAX_BODY_MB=15

# Configuração do Banco Vetorial Gerenciado: Google Cloud AlloyDB AI (pgvector + HNSW)
ALLOYDB_CLUSTER=auditops-alloydb-cluster
ALLOYDB_INSTANCE=auditops-alloydb-primary
ALLOYDB_HOST=
ALLOYDB_PORT=5432
ALLOYDB_DB=postgres
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=

# Configuração de Modelos por Nível de Complexidade (Model Cascading)
# Triagem e Auditoria Vetorial RAG na camada Flash 3.8 -> Escalonamento para 3.1 Pro nas regras de negócio
MODEL_TIER_FAST=gemini-3.8-flash
MODEL_TIER_STANDARD=gemini-3.8-flash
MODEL_TIER_REASONING=gemini-3.1-pro-preview
